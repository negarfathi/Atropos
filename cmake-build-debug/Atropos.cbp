            <Add directory="/usr/local/bin/../lib/clang/3.5.2/include" />
            <Add directory="/usr/local/include" />
         </Compiler>
         <MakeCommands>
            <Build command="/usr/bin/make -f &quot;/tmp/Atropos/cmake-build-debug/Makefile&quot;  VERBOSE=1 Atropos" />
